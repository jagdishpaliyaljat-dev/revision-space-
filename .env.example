# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Firebase project configuration.
# These values are public by design (Firebase API keys are not secrets; access is
# controlled by package name / SHA-1 and Firebase rules). They are injected into
# BuildConfig by the Secrets Gradle plugin so the app no longer uses dummy config.
# Values below are copied from the project's authoritative google-services.json
# (Firebase Console > Project settings > Your apps > Android app). Do not replace
# them with values from the legacy firebase-applet-config.json / web app config.
FIREBASE_PROJECT_ID=meta-ground-5t3g1
FIREBASE_APP_ID=1:260512472041:android:5fa734bd36d2b1ceab8978
FIREBASE_API_KEY=AIzaSyAljgROYkojSuGMZZ-6MPP0UrLhnIjcUWM
FIREBASE_AUTH_DOMAIN=meta-ground-5t3g1.firebaseapp.com
FIREBASE_STORAGE_BUCKET=meta-ground-5t3g1.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=260512472041
# Web OAuth client ID (client_type 3 in google-services.json).
# Required by GoogleSignInOptions.requestIdToken() for real Google sign-in.
FIREBASE_WEB_CLIENT_ID=260512472041-6tejv0trorv4stjte7k50tsoovvgs2vg.apps.googleusercontent.com
